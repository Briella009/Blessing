{
  "$schema": "https://specs.frictionlessdata.io/schemas/table-schema.json",
  "name": "aaio-core-incidents",
  "title": "AAIO Core Incident Table Schema",
  "description": "Tabular schema for the versioned Africa AI Incident Observatory core CSV. This schema describes structure and constraints; methodological inclusion rules remain authoritative in docs/methodology.md.",
  "primaryKey": "incident_id",
  "missingValues": [""],
  "fields": [
    {"name": "incident_id", "type": "string", "constraints": {"required": true, "pattern": "^AAIO-[0-9]{4}$", "unique": true}},
    {"name": "title", "type": "string", "constraints": {"required": true}},
    {"name": "incident_date", "type": "date", "constraints": {"required": true}},
    {"name": "date_precision", "type": "string", "constraints": {"required": true, "enum": ["day", "month", "approximate_day"]}},
    {"name": "country", "type": "string", "constraints": {"required": true}},
    {"name": "countries_affected", "type": "string", "constraints": {"required": true}},
    {"name": "region", "type": "string", "constraints": {"required": true}},
    {"name": "sector", "type": "string", "constraints": {"required": true}},
    {"name": "system_type", "type": "string", "constraints": {"required": true}},
    {"name": "ai_system_or_tool", "type": "string", "constraints": {"required": true}},
    {"name": "incident_or_hazard", "type": "string", "constraints": {"required": true, "enum": ["incident", "hazard"]}},
    {"name": "harm_types", "type": "string", "constraints": {"required": true}},
    {"name": "affected_parties", "type": "string", "constraints": {"required": true}},
    {"name": "summary", "type": "string", "constraints": {"required": true}},
    {"name": "reported_intent", "type": "string", "constraints": {"required": true}},
    {"name": "response", "type": "string", "constraints": {"required": true}},
    {"name": "regulatory_or_legal_outcome", "type": "string", "constraints": {"required": true}},
    {"name": "magnitude", "type": "integer", "constraints": {"required": true, "minimum": 0, "maximum": 4}},
    {"name": "scale", "type": "integer", "constraints": {"required": true, "minimum": 0, "maximum": 4}},
    {"name": "criticality", "type": "integer", "constraints": {"required": true, "minimum": 0, "maximum": 4}},
    {"name": "irreversibility", "type": "integer", "constraints": {"required": true, "minimum": 0, "maximum": 4}},
    {"name": "evidence_confidence", "type": "string", "constraints": {"required": true, "enum": ["A", "B", "C", "D"]}},
    {"name": "qualification_basis", "type": "string", "constraints": {"required": true}},
    {"name": "source_1_name", "type": "string", "constraints": {"required": true}},
    {"name": "source_1_url", "type": "string", "constraints": {"required": true}},
    {"name": "source_1_type", "type": "string", "constraints": {"required": true}},
    {"name": "source_2_name", "type": "string", "constraints": {"required": true}},
    {"name": "source_2_url", "type": "string", "constraints": {"required": true}},
    {"name": "source_2_type", "type": "string", "constraints": {"required": true}},
    {"name": "aiid_id", "type": "string"},
    {"name": "aiid_url", "type": "string"},
    {"name": "last_verified", "type": "date", "constraints": {"required": true}},
    {"name": "notes", "type": "string", "constraints": {"required": true}},
    {"name": "curator", "type": "string", "constraints": {"required": true}},
    {"name": "severity_score", "type": "integer", "constraints": {"required": true, "minimum": 0, "maximum": 100}},
    {"name": "severity_band", "type": "string", "constraints": {"required": true, "enum": ["Low", "Limited", "Moderate", "High", "Critical"]}}
  ]
}
