{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAIO Incident Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["incident_id","title","incident_date","date_precision","country","countries_affected","region","sector","system_type","ai_system_or_tool","incident_or_hazard","harm_types","affected_parties","summary","reported_intent","response","regulatory_or_legal_outcome","magnitude","scale","criticality","irreversibility","evidence_confidence","qualification_basis","source_1_name","source_1_url","source_1_type","source_2_name","source_2_url","source_2_type","aiid_id","aiid_url","last_verified","notes","curator","severity_score","severity_band"],
  "properties": {
    "incident_id": {"type":"string","minLength":1},
    "title": {"type":"string","minLength":1},
    "incident_date": {"type":"string","minLength":1},
    "date_precision": {"type":"string","enum":["day","month","approximate_day"]},
    "country": {"type":"string","minLength":1},
    "countries_affected": {"type":"string","minLength":1},
    "region": {"type":"string","minLength":1},
    "sector": {"type":"string","minLength":1},
    "system_type": {"type":"string","minLength":1},
    "ai_system_or_tool": {"type":"string","minLength":1},
    "incident_or_hazard": {"type":"string","enum":["incident","hazard"]},
    "harm_types": {"type":"string","minLength":1},
    "affected_parties": {"type":"string","minLength":1},
    "summary": {"type":"string","minLength":1},
    "reported_intent": {"type":"string","minLength":1},
    "response": {"type":"string","minLength":1},
    "regulatory_or_legal_outcome": {"type":"string","minLength":1},
    "evidence_confidence": {"type":"string","enum":["A","B","C","D"]},
    "qualification_basis": {"type":"string","minLength":1},
    "source_1_name": {"type":"string","minLength":1},
    "source_1_url": {"type":"string","minLength":1},
    "source_1_type": {"type":"string","minLength":1},
    "source_2_name": {"type":"string","minLength":1},
    "source_2_url": {"type":"string","minLength":1},
    "source_2_type": {"type":"string","minLength":1},
    "aiid_id": {"type":"string"},
    "aiid_url": {"type":"string"},
    "last_verified": {"type":"string","minLength":1},
    "notes": {"type":"string","minLength":1},
    "curator": {"type":"string","minLength":1},
    "severity_band": {"type":"string","enum":["Low","Limited","Moderate","High","Critical"]},
    "magnitude": {"type":"integer","minimum":0,"maximum":4},
    "scale": {"type":"integer","minimum":0,"maximum":4},
    "criticality": {"type":"integer","minimum":0,"maximum":4},
    "irreversibility": {"type":"integer","minimum":0,"maximum":4},
    "severity_score": {"type":"integer","minimum":0,"maximum":100}
  }
}
